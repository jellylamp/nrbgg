{#
/**
 * @file
 * Template for anonymous RSVP buttons.
 *
 * Available variables:
 * - nid: The event node ID.
 * - counts: Array of counts for each status.
 */
#}
<div class="event-rsvp-buttons">
  <a href="{{ path('event_rsvp.anonymous_form', {'node': nid, 'status': 'going'}) }}" 
     class="event-rsvp-button event-rsvp-anon-button"
     data-status="going"
     data-nid="{{ nid }}">
    ✓ Going
    <span class="event-rsvp-count count-going">({{ counts.going }})</span>
  </a>
  
  <a href="{{ path('event_rsvp.anonymous_form', {'node': nid, 'status': 'maybe'}) }}" 
     class="event-rsvp-button event-rsvp-anon-button"
     data-status="maybe"
     data-nid="{{ nid }}">
    ? Maybe
    <span class="event-rsvp-count count-maybe">({{ counts.maybe }})</span>
  </a>
  
  <a href="{{ path('event_rsvp.anonymous_form', {'node': nid, 'status': 'not_going'}) }}" 
     class="event-rsvp-button event-rsvp-anon-button"
     data-status="not_going"
     data-nid="{{ nid }}">
    ✗ Not Going
    <span class="event-rsvp-count count-not-going">({{ counts.not_going }})</span>
  </a>
</div>

<div class="anonymous-rsvp-form-container" style="display: none;">
  <div id="anonymous-rsvp-form"></div>
</div>