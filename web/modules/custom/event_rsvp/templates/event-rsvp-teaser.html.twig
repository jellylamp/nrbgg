{% set rsvp = event_rsvp_teaser %}

<div class="event-rsvp-teaser-wrapper">
  {% if rsvp.is_authenticated %}
    
    <div class="event-rsvp-buttons teaser-buttons">
      <a href="{{ path('event_rsvp.set_status', {'node': rsvp.nid, 'status': 'going'}) }}" 
         class="event-rsvp-button teaser-button{{ rsvp.current_status == 'going' ? ' active' : '' }}"
         data-status="going">
        ✓ Going <span class="event-rsvp-count count-going">({{ rsvp.counts.going }})</span>
      </a>
      
      <a href="{{ path('event_rsvp.set_status', {'node': rsvp.nid, 'status': 'maybe'}) }}" 
         class="event-rsvp-button teaser-button{{ rsvp.current_status == 'maybe' ? ' active' : '' }}"
         data-status="maybe">
        ? Maybe <span class="event-rsvp-count count-maybe">({{ rsvp.counts.maybe }})</span>
      </a>
      
      <a href="{{ path('event_rsvp.set_status', {'node': rsvp.nid, 'status': 'not_going'}) }}" 
         class="event-rsvp-button teaser-button{{ rsvp.current_status == 'not_going' ? ' active' : '' }}"
         data-status="not_going">
        ✗ Not Going <span class="event-rsvp-count count-not-going">({{ rsvp.counts.not_going }})</span>
      </a>
    </div>

  {% else %}
    <div class="event-rsvp-login-message">
      <p>{{ 'Please <a href="@login">log in</a> to RSVP for this event.'|t({'@login': path('user.login')}) }}</p>
    </div>
  {% endif %}
  {% if rsvp.capacity is not empty %}
    <div class="event-capacity-info {{ rsvp.capacity.class }}">
      <strong>{{ 'Event Capacity:'|t }}</strong> {{ rsvp.capacity.going }} / {{ rsvp.capacity.total }}
      <span class="spots-remaining">({{ rsvp.capacity.remaining }} {{ 'spots remaining'|t }})</span>
    </div>
  {% endif %}
</div>