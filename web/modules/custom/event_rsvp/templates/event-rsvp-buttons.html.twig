{#
/**
 * @file
 * Template for RSVP buttons.
 *
 * Available variables:
 * - nid: The event node ID.
 * - current_status: The user's current RSVP status.
 * - counts: Array of counts for each status.
 */
#}
<div class="event-rsvp-buttons">
  <a href="{{ path('event_rsvp.set_status', {'node': nid, 'status': 'going'}) }}" 
     class="event-rsvp-button{{ current_status == 'going' ? ' active' : '' }}"
     data-status="going">
    ✓ Going
    <span class="event-rsvp-count count-going">({{ counts.going }})</span>
  </a>
  
  <a href="{{ path('event_rsvp.set_status', {'node': nid, 'status': 'maybe'}) }}" 
     class="event-rsvp-button{{ current_status == 'maybe' ? ' active' : '' }}"
     data-status="maybe">
    ? Maybe
    <span class="event-rsvp-count count-maybe">({{ counts.maybe }})</span>
  </a>
  
  <a href="{{ path('event_rsvp.set_status', {'node': nid, 'status': 'not_going'}) }}" 
     class="event-rsvp-button{{ current_status == 'not_going' ? ' active' : '' }}"
     data-status="not_going">
    ✗ Not Going
    <span class="event-rsvp-count count-not-going">({{ counts.not_going }})</span>
  </a>
</div>