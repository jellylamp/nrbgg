<?php

/**
 * @file
 * Install, update and uninstall functions for the Event RSVP module.
 */

/**
 * Implements hook_schema().
 */
function event_rsvp_schema() {
  $schema['event_rsvp'] = [
    'description' => 'Stores RSVP responses for events',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique RSVP ID.',
      ],
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The node ID of the event.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user ID who is RSVPing (0 for anonymous).',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'description' => 'RSVP status: going, maybe, or not_going.',
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Name for anonymous RSVPs.',
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Email for anonymous RSVPs.',
      ],
      'accepted_conduct' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Whether code of conduct was accepted.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when RSVP was created.',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when RSVP was last changed.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'nid_uid' => ['nid', 'uid'],
      'nid_email' => ['nid', 'email'],
    ],
    'indexes' => [
      'nid' => ['nid'],
      'uid' => ['uid'],
      'status' => ['status'],
      'email' => ['email'],
    ],
  ];

  return $schema;
}

/**
 * Add fields for anonymous RSVPs and capacity limits.
 */
function event_rsvp_update_9001() {
  $schema = \Drupal::database()->schema();
  
  // Add new fields to event_rsvp table.
  $schema->addField('event_rsvp', 'name', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => FALSE,
    'description' => 'Name for anonymous RSVPs.',
  ]);
  
  $schema->addField('event_rsvp', 'email', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => FALSE,
    'description' => 'Email for anonymous RSVPs.',
  ]);
  
  $schema->addField('event_rsvp', 'accepted_conduct', [
    'type' => 'int',
    'size' => 'tiny',
    'not null' => TRUE,
    'default' => 0,
    'description' => 'Whether code of conduct was accepted.',
  ]);
  
  // Update uid to allow 0 for anonymous.
  $schema->changeField('event_rsvp', 'uid', 'uid', [
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => TRUE,
    'default' => 0,
    'description' => 'The user ID who is RSVPing (0 for anonymous).',
  ]);
  
  // Add index for email.
  $schema->addIndex('event_rsvp', 'email', ['email'], []);
  
  // Add unique key for email.
  $schema->addUniqueKey('event_rsvp', 'nid_email', ['nid', 'email']);
}