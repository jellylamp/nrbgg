<?php

/**
 * @file
 * Main module file for Event RSVP.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function event_rsvp_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  $rsvp_service = \Drupal::service('event_rsvp.service');
  $current_user = \Drupal::currentUser();
  $nid = $entity->id();
  $uid = $current_user->id();
  
  // Full View Mode Logic
  if ($entity->bundle() === 'event' && $view_mode === 'full') {
    $current_status = $rsvp_service->getRsvp($nid, $uid);
    $counts = $rsvp_service->getCounts($nid);
    $lists = $rsvp_service->getLists($nid);
    
    $build['event_rsvp'] = [
      '#type' => 'container',
      '#weight' => 100,
      '#attributes' => ['class' => ['event-rsvp-wrapper']],
      '#cache' => [
        'contexts' => ['user'],
        'tags' => ['event_rsvp:' .
$entity->id()],
      ],
    ];
    
    // Show capacity info if set.
    if ($entity->hasField('field_max_event_cap') && !empty($entity->get('field_max_event_cap')->value)) {
      $capacity = $entity->get('field_max_event_cap')->value;
      $spots_left = max(0, $capacity - $counts['going']);
      $capacity_class = $spots_left == 0 ? 'capacity-full' : ($spots_left <= 3 ? 'capacity-low' : 'capacity-available');
      $build['event_rsvp']['capacity'] = [
        '#markup' => '<div class="event-capacity-info ' . $capacity_class . '">
          <strong>' .
t('Capacity:') . '</strong> ' . 
          $counts['going'] . ' / ' . $capacity .
' <span class="spots-remaining">(' . $spots_left . ' ' . t('spots remaining') . ')</span>
        </div>',
      ];
    }

    // RSVP Buttons (only for logged-in users).
    if ($current_user->isAuthenticated()) {
      $build['event_rsvp']['buttons'] = [
        '#theme' => 'event_rsvp_buttons',
        '#nid' => $nid,
        '#current_status' => $current_status,
        '#counts' => $counts,
        '#attached' => [
          'library' => ['event_rsvp/rsvp'],
        ],
      ];
    }
    else {
      $build['event_rsvp']['login_message'] = [
        '#markup' => '<p>' .
t('Please <a href="@login">log in</a> to RSVP for this event.', [
          '@login' => \Drupal\Core\Url::fromRoute('user.login')->toString(),
        ]) .
'</p>',
      ];
    }

    // RSVP Lists.
    $build['event_rsvp']['lists'] = [
      '#theme' => 'event_rsvp_list',
      '#going' => $lists['going'],
      '#maybe' => $lists['maybe'],
      '#not_going' => $lists['not_going'],
    ];
  }
  
  // Teaser View Mode Logic
  if ($entity->bundle() === 'event' && $view_mode === 'teaser') {
    $title = $entity->label();
    
    $date_field = $entity->get('field_event_date_and_time')->view(['label' => 'hidden', 'type' => 'datetime_default']);
    $date_time = \Drupal::service('renderer')->render($date_field);
    
    $current_status = $current_user->isAuthenticated() ? $rsvp_service->getRsvp($nid, $uid) : NULL;
    $counts = $rsvp_service->getCounts($nid);
    $lists = $current_user->isAuthenticated() ? $rsvp_service->getLists($nid) : [];
    
    $event_rsvp_teaser_data = [
      'nid' => $nid,
      'counts' => $counts,
      'current_status' => $current_status,
      'is_authenticated' => $current_user->isAuthenticated(),
      'lists' => $lists,
      'title' => $title,
      'date_time' => $date_time,
    ];
    
    // Check capacity info if field exists.
    if ($entity->hasField('field_max_event_cap') && !empty($entity->get('field_max_event_cap')->value)) {
      $capacity = $entity->get('field_max_event_cap')->value;
      $spots_left = max(0, $capacity - $counts['going']);
      $event_rsvp_teaser_data['capacity'] = [
        'total' => $capacity,
        'going' => $counts['going'],
        'remaining' => $spots_left,
        'class' => $spots_left == 0 ? 'capacity-full' : ($spots_left <= 3 ? 'capacity-low' : 'capacity-available'),
      ];
    }
    
    $build['event_rsvp_teaser'] = [
      '#theme' => 'event_rsvp_teaser',
      '#event_rsvp_teaser' => $event_rsvp_teaser_data,
      '#weight' => 50,
      '#cache' => [
        'contexts' => ['user'],
        'tags' => ['event_rsvp:' . $nid],
      ],
      '#attached' => $current_user->isAuthenticated() ? ['library' => ['event_rsvp/rsvp']] : [],
    ];
  }
}

/**
 * Implements hook_theme().
 */
function event_rsvp_theme($existing, $type, $theme, $path) {
  return [
    'event_rsvp_buttons' => [
      'variables' => [
        'nid' => NULL,
        'current_status' => NULL,
        'counts' => [],
      ],
    ],
    'event_rsvp_list' => [
      'variables' => [
        'going' => [],
        'maybe' => 
[],
        'not_going' => [],
      ],
    ],
    'event_rsvp_teaser' => [
      'variables' => [
        'event_rsvp_teaser' => [],
      ],
    ],
  ];
}