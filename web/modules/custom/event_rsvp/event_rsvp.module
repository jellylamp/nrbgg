<?php

/**
 * @file
 * Main module file for Event RSVP.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function event_rsvp_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Only add RSVP to event content type nodes in full view mode.
  if ($entity->bundle() !== 'event' || $view_mode !== 'full') {
    return;
  }
  
  $rsvp_service = \Drupal::service('event_rsvp.service');
  $current_user = \Drupal::currentUser();
  
  $nid = $entity->id();
  $uid = $current_user->id();
  $current_status = $rsvp_service->getRsvp($nid, $uid);
  $counts = $rsvp_service->getCounts($nid);
  $lists = $rsvp_service->getLists($nid);

  $build['event_rsvp'] = [
    '#type' => 'container',
    '#weight' => 100,
    '#attributes' => ['class' => ['event-rsvp-wrapper']],
    '#cache' => [
      'contexts' => ['user'],
      'tags' => ['event_rsvp:' . $entity->id()],
    ],
  ];
  
  // Show capacity info if set.
  if ($entity->hasField('field_event_capacity') && !empty($entity->get('field_event_capacity')->value)) {
    $capacity = $entity->get('field_event_capacity')->value;
    $spots_left = $capacity - $counts['going'];
    
    $build['event_rsvp']['capacity'] = [
      '#markup' => '<div class="event-capacity-info"><strong>' . t('Capacity:') . '</strong> ' . $counts['going'] . ' / ' . $capacity . ' (' . max(0, $spots_left) . ' ' . t('spots left') . ')</div>',
    ];
  }

  // RSVP Buttons (only for logged-in users).
  if ($current_user->isAuthenticated()) {
    $build['event_rsvp']['buttons'] = [
      '#theme' => 'event_rsvp_buttons',
      '#nid' => $nid,
      '#current_status' => $current_status,
      '#counts' => $counts,
      '#attached' => [
        'library' => ['event_rsvp/rsvp'],
      ],
    ];
  }
  else {
    // Anonymous users get buttons that open a form.
    $build['event_rsvp']['anon_buttons'] = [
      '#theme' => 'event_rsvp_anonymous_buttons',
      '#nid' => $nid,
      '#counts' => $counts,
      '#attached' => [
        'library' => ['event_rsvp/rsvp'],
      ],
    ];
    
    // Add the form (hidden by default).
    $build['event_rsvp']['anon_form'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['anonymous-rsvp-form-container'],
        'style' => 'display: none;',
      ],
    ];
  }

  // RSVP Lists.
  $build['event_rsvp']['lists'] = [
    '#theme' => 'event_rsvp_list',
    '#going' => $lists['going'],
    '#maybe' => $lists['maybe'],
    '#not_going' => $lists['not_going'],
  ];
}

/**
 * Implements hook_theme().
 */
function event_rsvp_theme($existing, $type, $theme, $path) {
  return [
    'event_rsvp_buttons' => [
      'variables' => [
        'nid' => NULL,
        'current_status' => NULL,
        'counts' => [],
      ],
    ],
    'event_rsvp_anonymous_buttons' => [
      'variables' => [
        'nid' => NULL,
        'counts' => [],
      ],
    ],
    'event_rsvp_list' => [
      'variables' => [
        'going' => [],
        'maybe' => [],
        'not_going' => [],
      ],
    ],
  ];
}